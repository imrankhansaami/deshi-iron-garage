[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
anti_aliasing/quality/msaa_3d=2
anti_aliasing/screen_space_subsurface_scattering=false
textures/default_filters/anisotropic_filtering_level=4
textures/vram_compression/import_etc2_astc=false
depth_of_field/depth_of_field_bokeh_shape=1
environment/defaults/default_clear_color=Color(0.0431373, 0.0470588, 0.054902, 1)
meshing/limits/max_linear_surface_area=200000000
2d/snap_y_up=true
