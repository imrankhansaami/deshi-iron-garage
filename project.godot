; Engine configuration file.
; DESHI IRON GARAGE — The Dream of a Bangladeshi Inventor
; Godot 4.x — Interactive 3D workshop exploration (CG final-year project)

config_version=5

[application]

config/name="Deshi Iron Garage"
config/description="An interactive realistic 3D Bangladeshi workshop experience: first-person exploration, procedural PBR props, holographic and energy-core shaders, and an original exosuit prototype assembly sequence."
run/main_scene="res://scenes/main/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/textures/ui/garage_icon.svg"
run/low_processor_mode=false

[autoload]

EventBus="*res://scripts/core/event_bus.gd"
GameConfig="*res://scripts/core/game_config.gd"
GameState="*res://scripts/core/game_state.gd"
MaterialLibrary="*res://scripts/core/material_library.gd"
AudioBank="*res://scripts/core/audio_bank.gd"

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/incompatible_assign_reference=1
gdscript/warnings/shadowing_variable=1
gdscript/warnings/unused_signal=0

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[gui]

theme/default_font_multichannel_signed_distance_field=true
fonts/allow_timeout=false

[input]

move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":87,"key_label":0,"unicode":119,"location":0,"echo":false,"script":null)
]
}
